{
    "name": "koishi-plugin-chatluna-hub",
    "description": "Do you like long, cluttered sidebars? I don't, so here's my solution.",
    "version": "0.7.0",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "files": [
        "lib",
        "dist",
        "client"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Procyon-Nan/koishi-plugin-chatluna-hub.git"
    },
    "contributors": [
        "Procyon-Nan <3189960265@qq.com>"
    ],
    "scripts": {
        "build:server": "node scripts/build-server.cjs",
        "build:client": "node scripts/build-client.cjs",
        "build": "npm run build:server && npm run build:client",
        "clean": "node scripts/clean-artifacts.cjs",
        "prepack": "npm run clean && npm run build && node scripts/check-artifacts.cjs",
        "typecheck:client": "node scripts/typecheck-client.cjs",
        "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./test/register-hooks.mjs --test \"test/**/*.test.ts\"",
        "lint": "yarn eslint src --ext=ts",
        "lint-fix": "yarn eslint src --ext=ts --fix"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin"
    ],
    "yakumo": {
        "client": "scripts/client-vite-config.cjs"
    },
    "comment:codemirror-dedupe": "CodeMirror types are nominal and its extensions are registered per module instance, so two physical copies break tsc assignability and runtime extension lookup alike. These pins keep one copy of each. Both fields are only honoured when this package is the install root (yarn 4 reads resolutions from the top-level workspace manifest only; npm ignores overrides from dependencies), i.e. for a standalone clone of this repo. Inside the koishi-dev monorepo the same pins must live in that root manifest, and client/tsconfig.json paths plus scripts/client-vite-config.cjs resolve.dedupe cover type-checking and bundling.",
    "resolutions": {
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/lint": "^6.9.7"
    },
    "overrides": {
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/lint": "^6.9.7"
    },
    "dependencies": {
        "@langchain/core": "^0.3.80",
        "js-yaml": "^4.1.1",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@codemirror/autocomplete": "^6.20.2",
        "@codemirror/lint": "^6.9.6",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@element-plus/icons-vue": "^2.3.2",
        "@koishijs/client": "^5.30.11",
        "@koishijs/plugin-console": "^5.30.11",
        "@types/js-yaml": "^4.0.9",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@typescript-eslint/eslint-plugin": "^7.18.1-alpha.3",
        "@typescript-eslint/parser": "^8.45.1-alpha.0",
        "codemirror": "^6.0.2",
        "element-plus": "2.7.7",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-promise": "^7.2.1",
        "highlight.js": "^11.11.1",
        "koishi": "^4.18.9",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "typescript": "^5.6.2"
    },
    "peerDependencies": {
        "@koishijs/plugin-console": "^5.30.11",
        "koishi": "^4.18.9"
    },
    "koishi": {
        "description": {
            "zh": "ChatLuna 生态统一 WebUI Hub",
            "en": "Unified WebUI hub for the ChatLuna ecosystem"
        },
        "service": {
            "optional": [
                "console",
                "chatluna"
            ]
        },
        "browser": true
    }
}
